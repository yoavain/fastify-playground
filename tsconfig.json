{
    "extends": "@tsconfig/node24",
    "compilerOptions": {
        "lib": ["es2020", "dom"],
        "strict": false,
        "moduleResolution": "NodeNext",
        "verbatimModuleSyntax": false,
        "allowJs": true,
        "noEmit": true
    },
    "ts-node": {
        "compilerOptions": {
            "rootDir": "./src"
        }
    },
    "include": ["./src/**/*", "./test/**/*", "./e2e/**/*", "./*.ts", "./*.js"]
}
