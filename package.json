{
  "name": "fastify-playground",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "npx fix-lockfile-integrity package-lock.json",
    "build": "tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "start": "node -r ts-node/register/transpile-only src/server.ts",
    "start:debug": "node --inspect-brk -r ts-node/register/transpile-only src/server.ts",
    "prestart:fastify": "npm run build",
    "start:fastify": "fastify start dist/server.js",
    "print-routes": "fastify print-routes dist/server.js",
    "help:fastify": "fastify --help"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.12.3",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "dotenv": "17.4.2",
    "eslint": "8.57.1",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-security": "1.7.1",
    "fastify-cli": "8.0.0",
    "lint-staged": "17.0.2",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/fastify": "3.1.0",
    "@fastify/autoload": "6.3.1",
    "@fastify/compress": "8.3.1",
    "@fastify/helmet": "13.0.2",
    "@fastify/multipart": "10.0.0",
    "@fastify/static": "9.1.3",
    "fastify": "5.8.5",
    "fastify-plugin": "5.1.0",
    "file-type": "16.5.4",
    "graphql": "16.14.0",
    "graphql-tag": "2.12.6"
  },
  "overrides": {
    "minimatch": "^9.0.9"
  }
}
